generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Animal {
  id            String    @id @default(cuid())
  copaip        String    @default("FR")
  nunati        String    @unique
  nutrav        String    @unique
  nobovi        String?
  danais        DateTime
  sexbov        String    @default("F")
  statut        String    @default("ACTIF")
  race          String    @default("BLONDE_AQUITAINE")
  estGenisse    Boolean   @default(false)

  // Catégorie métier manuelle (VEAU_M|VEAU_F|VELLE|PRESELECTION_GENISSE|GENISSE_VALIDEE|PETITE_GENISSE|MOYENNE_GENISSE|GRANDE_GENISSE|TAUREAU|VACHE)
  categorie     String?

  groupeId      String?
  groupe        Groupe?   @relation(fields: [groupeId], references: [id])

  aEchographier Boolean   @default(false)

  copami        String?
  numeip        String?
  nomeip        String?
  tramip        String?

  mereId        String?
  mere          Animal?   @relation("Genealogie", fields: [mereId], references: [id])
  veaux         Animal[]  @relation("Genealogie")

  taureauId     String?
  taureau       Taureau?  @relation(fields: [taureauId], references: [id])

  boucleNumero  String?
  boucleFaite   Boolean   @default(false)
  sevreFait     Boolean   @default(false)
  dateSevrage   DateTime?
  tarieFaite    Boolean   @default(false)
  dateTarie     DateTime?

  localisationId String?
  localisation   Localisation? @relation(fields: [localisationId], references: [id])

  saillies        Saillie[]
  velagesVache    Velage[]        @relation("VelageVache")
  velageVeau      Velage?         @relation("VelageVeau")
  pesees          Pesee[]
  vaccinations    Vaccination[]
  evenements      EvenementSanitaire[]
  parages         Parage[]
  complementsAlim ComplementAlim[]
  chaleurs        Chaleur[]
  traitements     Traitement[]

  notes         String?

  sortie        Sortie?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Groupe {
  id        String   @id @default(cuid())
  nom       String   @unique
  couleur   String?
  animaux   Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Taureau {
  id       String   @id @default(cuid())
  copaip   String   @default("FR")
  nupere   String   @unique
  nopere   String?
  traper   String?
  present  Boolean  @default(true)

  animaux  Animal[]
  saillies Saillie[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Saillie {
  id          String   @id @default(cuid())
  animalId    String
  animal      Animal   @relation(fields: [animalId], references: [id])
  date        DateTime
  type        String
  estimation  Boolean  @default(false)
  groupage    Boolean  @default(false)
  tentative   Int      @default(1)
  taureauId   String?
  taureau     Taureau? @relation(fields: [taureauId], references: [id])

  gestation   Gestation?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gestation {
  id               String    @id @default(cuid())
  saillieId        String    @unique
  saillie          Saillie   @relation(fields: [saillieId], references: [id])
  etat             String    @default("GRIS")
  dateEcho         DateTime?
  joursGestation   Int?
  dateVelagePrevue DateTime?
  resultatEcho     String?
  sousResultat     String?

  velage           Velage?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Velage {
  id            String    @id @default(cuid())
  date          DateTime
  qualificatif  String    @default("NORMAL")
  sousType      String?

  vacheId       String
  vache         Animal    @relation("VelageVache", fields: [vacheId], references: [id])

  veauId        String?   @unique
  veau          Animal?   @relation("VelageVeau", fields: [veauId], references: [id])

  gestationId   String?   @unique
  gestation     Gestation? @relation(fields: [gestationId], references: [id])

  capteur       Int?
  pereNom       String?
  pereNunati    String?
  jumeaux       Boolean   @default(false)

  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Vaccination {
  id         String    @id @default(cuid())
  animalId   String
  animal     Animal    @relation(fields: [animalId], references: [id])
  vaccin     String
  date       DateTime
  voie       String?
  dose       Float?
  statut     String    @default("FAIT")
  ordonnanceNumero String?
  ordonnanceId String?
  ordonnance Ordonnance? @relation(fields: [ordonnanceId], references: [id])
  veterinaire String?
  notes      String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model EvenementSanitaire {
  id          String    @id @default(cuid())
  animalId    String
  animal      Animal    @relation(fields: [animalId], references: [id])
  categorie   String?
  type        String
  date        DateTime
  moment      String?
  temperature Float?
  description String?
  photos      String?
  constatePar String?
  resolu      Boolean   @default(false)
  dateResolu  DateTime?

  symptomes   EvenementSymptome[]
  traitements Traitement[]
  reponses    QuestionReponse[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model EvenementSymptome {
  id              String             @id @default(cuid())
  evenementId     String
  evenement       EvenementSanitaire @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  typeEvenementId String?
  typeEvenement   TypeEvenement?     @relation(fields: [typeEvenementId], references: [id])
  libelle         String
  groupe          String?

  createdAt DateTime @default(now())
}

/// Catalogue des types d'événements sanitaires recherchables (avec synonymes),
/// remplace les deux blocs figés "Ce que j'observe" / "Ce qui est identifié".
/// categorie sert uniquement au classement interne / statistiques.
model TypeEvenement {
  id        String   @id @default(cuid())
  nom       String   @unique
  synonymes String?
  categorie String   @default("AUTRE")
  actif     Boolean  @default(true)

  questions QuestionTemplate[]
  symptomes EvenementSymptome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bibliothèque de questions facultatives associées à un type d'événement,
/// modifiable sans casser les réponses déjà enregistrées (stored_label snapshot).
model QuestionTemplate {
  id                 String        @id @default(cuid())
  typeEvenementId    String
  typeEvenement      TypeEvenement @relation(fields: [typeEvenementId], references: [id], onDelete: Cascade)
  label              String
  type               String
  options            String?
  unite              String?
  obligatoire        Boolean       @default(false)
  ordre              Int           @default(0)
  conditionAffichage String?
  actif              Boolean       @default(true)

  reponses QuestionReponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionReponse {
  id                String             @id @default(cuid())
  evenementId       String
  evenement         EvenementSanitaire @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  questionId        String
  question          QuestionTemplate   @relation(fields: [questionId], references: [id])
  libelleEnregistre String
  valeur            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([evenementId, questionId])
}

model Pesee {
  id         String   @id @default(cuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id])
  date       DateTime
  poids      Float

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Parage {
  id         String   @id @default(cuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id])
  date       DateTime
  pattes     String
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ComplementAlim {
  id         String   @id @default(cuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id])
  type       String
  date       DateTime
  statut     String   @default("PREVU")
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Localisation {
  id      String   @id @default(cuid())
  nom     String   @unique
  type    String
  animaux Animal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CapteurVelage {
  id              String    @id @default(cuid())
  numero          Int       @unique
  animalNutrav    String?
  animalNom       String?
  dateAttribution DateTime?
  actif           Boolean   @default(false)

  updatedAt DateTime @updatedAt
}

model Sortie {
  id              String    @id @default(cuid())
  animalId        String    @unique
  animal          Animal    @relation(fields: [animalId], references: [id])
  date            DateTime
  type            String    // MORT | ELEVAGE | BOUCHERIE | ENGRAISSEMENT

  acheteur        String?
  prixKilo        Float?
  poids           Float?   // poids carcasse pour BOUCHERIE, poids vif sinon
  poidsVif        Float?   // poids vif avant abattage (BOUCHERIE)
  rendementCarcasse Float? // % rendement carcasse (ex: 55.0)
  prixPrevuHT     Float?
  prixDefinitifHT Float?

  dateDebutEngr   DateTime?

  causeMortalite  String?

  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model VenteHistorique {
  id          String  @id @default(cuid())
  annee       Int
  typeAnimal  String  // veaux, vaches, taureau, génisse
  typeVente   String  // vif, carcasse
  nutrav      String?
  sexe        String? // M, F
  poidsVif    Float?
  prixKgVif   Float?
  poidsCarc   Float?
  prixKgCarc  Float?
  acheteur    String?
  date        DateTime
  total       Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StatsAnnuelle {
  id               String  @id @default(cuid())
  annee            Int     @unique
  veauxCount       Int     @default(0)
  veauxMCount      Int     @default(0)
  veauxFCount      Int     @default(0)
  veauxKgTotal     Float   @default(0)
  veauxPrixMoyen   Float?
  veauxCA          Float   @default(0)
  vachesCount      Int     @default(0)
  vachesKgCarcasse Float   @default(0)
  vachesPrixMoyen  Float?
  vachesCA         Float   @default(0)
  velagesCount     Int     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Chaleur {
  id        String   @id @default(cuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id])
  date      DateTime
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FcmToken {
  id          String    @id @default(cuid())
  token       String    @unique
  device      String?
  lastNotifAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PushSubscription {
  id          String    @id @default(cuid())
  endpoint    String    @unique
  p256dh      String
  auth        String
  device      String?
  lastNotifAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProtocoleVaccin {
  id                 String   @id @default(cuid())
  nom                String   @unique
  label              String
  ordre              Int      @default(0)
  ageMinJours        Int      @default(0)
  urgenceJours       Int?
  estRappel          Boolean  @default(false)
  primoNom           String?
  delaiRappelJours   Int?
  urgenceRappelJours Int?
  obligatoireVente   Boolean  @default(false)
  voiePrimo          String   @default("IM")
  voieRappel         String   @default("IM")
  rappelAnnuel       Boolean  @default(false)
  actif              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Medicament {
  id                  String       @id @default(cuid())
  nom                 String       @unique
  dci                 String?
  forme               String?
  categorie           String       @default("AUTRE")
  voie                String?
  dosagePourKg        Float?
  uniteDosage         String?      @default("ml")
  delaiAttenteViandeJ Int?
  delaiAttenteLaitJ   Int?
  prescriptionRequise Boolean      @default(false)
  actif               Boolean      @default(true)
  temporaire          Boolean      @default(false)
  commentaire         String?
  stockActuel         Float?
  stockUnite          String?
  stockSeuilAlert     Float?
  favori              Boolean      @default(false)
  /// Actions simples pour l'affichage répertoire (ex: "Douleur,Inflammation,Fièvre")
  actions             String?
  traitements         Traitement[]
  preconisations      Preconisation[]
  termes              MedicamentTerme[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// Glossaire "En savoir +" associé à un médicament : termes techniques
/// employés dans ses préconisations, avec une explication en langage clair.
model MedicamentTerme {
  id           String     @id @default(cuid())
  medicamentId String
  medicament   Medicament @relation(fields: [medicamentId], references: [id], onDelete: Cascade)

  terme       String
  explication String
  ordre       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicamentId])
}

/// Une ou plusieurs préconisations par médicament (dose/voie/délais selon
/// l'indication). Référentiel à nettoyer et vérifier — n'alimente PAS
/// automatiquement la suggestion de traitement tant que statut != "VALIDE".
model Preconisation {
  id           String     @id @default(cuid())
  medicamentId String
  medicament   Medicament @relation(fields: [medicamentId], references: [id], onDelete: Cascade)

  indicationMotif  String?
  categorieAnimaux String?
  agePoidsConcerne String?

  dose                  Float?
  unite                 String?
  doseBase              String?
  voie                  String?
  frequence             String?
  dureeValeur           Int?
  dureeUnite            String?
  nombreAdministrations Int?

  precautions             String?
  delaiAttenteViandeJ     Int?
  delaiAttenteLaitTraites Int?

  source                  String?
  statut                  String  @default("A_VERIFIER")
  commentaireVerification String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Traitement {
  id            String      @id @default(cuid())
  animalId      String
  animal        Animal      @relation(fields: [animalId], references: [id])
  evenementId   String?
  evenement     EvenementSanitaire? @relation(fields: [evenementId], references: [id])
  medicamentId  String?
  medicament    Medicament? @relation(fields: [medicamentId], references: [id])
  medicamentNom String
  dateDebut     DateTime
  dureeJours    Int         @default(1)
  voie          String?
  frequence     String?
  doseRecommandee Float?
  dose          Float?
  uniteDosage   String?
  poidsUtilise  Float?
  motif         String?
  veterinaire   String?
  ordonnanceNumero String?
  ordonnanceId  String?
  ordonnance    Ordonnance? @relation(fields: [ordonnanceId], references: [id])
  ordonnanceAAssocier Boolean @default(false)
  delaiAttenteViandeJ Int?
  delaiAttenteLaitJ   Int?
  statut        String      @default("EN_COURS")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ExploitationConfig {
  id                     String   @id @default("singleton")
  ipg                    String?
  raisonSociale          String?
  adresse                String?
  telephone              String?
  veterinaireNom         String?
  veterinaireAdresse     String?
  veterinaireTel         String?
  ordonnancierNo         String?
  affichageDelaiAttente  String   @default("LES_DEUX")
  updatedAt              DateTime @updatedAt
}

model Ordonnance {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  numero         String?
  veterinaireNom String?
  medicamentNom  String   @default("")
  dose           Float?
  uniteDosage    String?
  voie           String?
  frequence      String?
  dureeJours     Int?
  delaiAttenteViandeJ Int?
  delaiAttenteLaitJ   Int?
  precautions    String?
  rappels        String?
  motif          String?
  animaux        String?
  statut         String   @default("VALIDE")
  notes          String?
  photoUrl       String?
  traitements    Traitement[]
  vaccinations   Vaccination[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NoteTerrain {
  id        String   @id @default(cuid())
  texte     String
  traitee   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionLog {
  id          String    @id @default(cuid())
  type        String
  description String
  revertData  String
  reverted    Boolean   @default(false)
  revertedAt  DateTime?
  createdAt   DateTime  @default(now())
}
